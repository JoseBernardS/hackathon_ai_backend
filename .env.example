PORT=4000

# MongoDB — local or Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/hackathon

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=my-hackathon-bucket

# OTP signing secret (used only by the local fallback provider)
OTP_SECRET=hackathon-local-otp-secret-change-me

# Infobip 2FA. Without these the OTP is logged and returned as devCode.
INFOBIP_BASE_URL=https://k9lrmn.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_APPLICATION_ID=
INFOBIP_MESSAGE_ID=
INFOBIP_SENDER_ID=ServiceSMS

# JWT signing
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Set to "local" to print the OTP in the terminal instead of sending a real SMS
OTP_PROVIDER=

# Comma-separated frontend origins. Unset = allow all (fine for the hackathon).
CORS_ORIGINS=

# Claude API key for photo analysis. Unset = the AI step degrades to a blank form.
ANTHROPIC_API_KEY=

MDC311_METHOD_CREATE_REQUEST=createServiceRequest

MDC311_METHOD_GET_REQUEST=getServiceRequest

MDC311_METHOD_SERVICE_TYPES=getServiceTypes

# Still unknown. Watch the network tab on 311.miamidade.gov while picking
# a service type — the call fires on selection, before location or contact.
MDC311_METHOD_SERVICE_DEFINITION=
